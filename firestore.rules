rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SECURITY & PRIVACY ENFORCEMENT:
    // All client booking writes and reads, admin operations, and availability calculations
    // are strictly executed server-side via the Firebase Admin SDK inside Next.js API routes.
    // The browser client SDK is completely denied read and write access to all collections
    // to guarantee zero exposure of client PII, booking details, or scheduling rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
