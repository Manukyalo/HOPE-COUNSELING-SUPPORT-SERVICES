# ─── Firebase (Client SDK — safe to expose) ──────────────────────────────────
# All NEXT_PUBLIC_ vars are bundled into the browser JS. Only Firebase
# client-safe values belong here.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Admin Portal (Server-side only — NEVER prefix with NEXT_PUBLIC_) ─────────
# ADMIN_SESSION_SECRET — HMAC signing key for admin session cookies.
#   Generate with: node -e "require('crypto').randomBytes(32).toString('hex')|Write-Host"
#   Minimum 32 characters. Rotating this invalidates all existing sessions.
ADMIN_SESSION_SECRET=generate-a-64-char-random-hex-string

# ADMIN_PIN — Numeric PIN for practitioner quick unlock
ADMIN_PIN=choose-a-numeric-pin

# ─── Firebase Admin SDK (Server-side only) ────────────────────────────────────
# Option 1 (Recommended for Vercel): Single base64 or JSON string of service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=your_base64_or_json_service_account_here

# Option 2: Individual variables
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ─── SMS Notifications (Africa's Talking) ─────────────────────────────────────
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_SENDER_ID=HOPECARE
ADMIN_NOTIFICATION_PHONE=+254701279231
ADMIN_NOTIFICATION_EMAIL=amayakari5924@gmail.com

# ─── Payments (IntaSend M-Pesa STK Push) ──────────────────────────────────────
INTASEND_PUBLIC_KEY=ISPubKey_live_...
INTASEND_SECRET_KEY=ISSecretKey_live_...
INTASEND_WEBHOOK_SECRET=your_webhook_secret

# ─── Cron & Background Tasks ──────────────────────────────────────────────────
CRON_SECRET=generate-a-random-secret-for-cron-triggers
NEXT_PUBLIC_APP_URL=https://hope-counseling-support-services.vercel.app

