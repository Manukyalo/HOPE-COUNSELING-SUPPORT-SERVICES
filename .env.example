# ─── Firebase (Client SDK — safe to expose) ──────────────────────────────────
# All NEXT_PUBLIC_ vars are bundled into the browser JS. Only Firebase
# client-safe values belong here.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Admin Portal (Server-side only — NEVER prefix with NEXT_PUBLIC_) ─────────
# REQUIRED: Must be set before the server starts or admin auth routes will
# fail closed with a 500. Never commit real values.
#
# ADMIN_SESSION_SECRET — HMAC signing key for admin session cookies.
#   Generate with: node -e "require('crypto').randomBytes(32).toString('hex')|Write-Host"
#   Minimum 32 characters. Rotating this invalidates all existing sessions.
ADMIN_SESSION_SECRET=generate-a-64-char-random-hex-string

# ADMIN_PIN — Numeric PIN for the practitioner quick-unlock flow.
#   Choose a PIN you haven't used elsewhere. No default — if unset,
#   PIN auth is disabled and only Firebase email/password login works.
ADMIN_PIN=choose-a-numeric-pin
